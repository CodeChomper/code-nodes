{
  "name": "code-nodes",
  "displayName": "Code Nodes",
  "publisher": "CodeChomper",
  "repository": "https://github.com/CodeChomper/code-nodes",
  "icon": "icon.png",
  "description": "Block-based markdown editor with wiki-link graph visualization",
  "version": "0.1.9",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Notebooks",
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "codeNodes.markdownEditor",
        "displayName": "Code Nodes Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "codeNodes.openGraph",
        "title": "Code Nodes: Open Graph View",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "codeNodes.newNote",
        "title": "Code Nodes: New Note"
      },
      {
        "command": "codeNodes.dailyNote",
        "title": "Code Nodes: Today's Note"
      }
    ],
    "keybindings": [
      {
        "command": "codeNodes.openGraph",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      },
      {
        "command": "codeNodes.dailyNote",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "codeNodes.openGraph",
          "group": "navigation",
          "when": "activeCustomEditorId == 'codeNodes.markdownEditor'"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production && vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.7.1",
    "dictionary-en": "^4.0.0",
    "esbuild": "^0.21.0",
    "highlight.js": "^11.11.1",
    "marked": "^12.0.0",
    "nspell": "^2.1.5",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "mermaid": "^11.14.0",
    "sigma": "^3.0.3"
  }
}
